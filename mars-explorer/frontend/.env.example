# Copy to frontend/.env.local (git-ignored). Every VITE_ variable is embedded into the
# client bundle and visible to anyone who opens the app: NEVER put secrets or API keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# NASA Mars Trek WMTS base for equirectangular ("EQ") layers. No API key is required.
# Can later point to a local tile mirror for offline use.
VITE_TREK_WMTS_BASE=https://trek.nasa.gov/tiles/Mars/EQ
