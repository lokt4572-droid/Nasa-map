# Copy to backend/.env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-for-local-development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Relative paths are resolved against the backend/ directory.
MARS_DATA_DIR=../data/mars
LOG_LEVEL=INFO
# Server-side only. Not required by NASA Trek, GIBS, Open-Meteo, POWER or Nominatim.
# Leave empty unless a future integration with api.nasa.gov needs it. Never put it into a VITE_ variable.
NASA_API_KEY=

# --- External providers (v0.2). Defaults are the public endpoints.
# Identify the application to OSM/Nominatim (their policy forbids generic library agents).
HTTP_USER_AGENT=MARS-EXPLORER/0.2 (planetary GIS prototype; local)
# Point to your own Nominatim instance for heavier use (public instance: max 1 request/s).
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# Max file size for POST /api/v1/datasets/register/ (bigger files: python manage.py import_dem)
MAX_REGISTER_FILE_BYTES=524288000
