# Copy to backend/.env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-for-local-development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Relative paths are resolved against the backend/ directory.
MARS_DATA_DIR=../data/mars
LOG_LEVEL=INFO
# Server-side only. Not required by NASA Trek WMTS. Leave empty unless a future
# integration with api.nasa.gov needs it. Never put it into a VITE_ variable.
NASA_API_KEY=
